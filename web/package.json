{
  "name": "bayesnet-browser",
  "version": "0.2.0",
  "description": "PDOPT-BN local-first Bayesian network workspace",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node tools/vendor.mjs",
    "build": "node tools/vendor.mjs && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:numerical": "vitest run tests/numerical.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format:check": "prettier --check src tests tools *.ts *.html *.json docs README.md"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@vue-flow/core": "1.48.2",
    "elkjs": "^0.12.1",
    "jsagrum": "0.1.3",
    "papaparse": "^5.7.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
